# ═══════════════════════════════════════════
# SkillNav Environment Variables
# Copy to .env and fill in your SAP BTP values.
# All SAP values are optional — the app falls
# back to local engines when not configured.
# ═══════════════════════════════════════════

# ── SAP HANA Cloud ──
HANA_HOST=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=

# ── SAP AI Core / Generative AI Hub ──
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=default

# ── SAP Build Process Automation ──
SAP_BUILD_WORKFLOW_URL=
SAP_BUILD_CLIENT_ID=
SAP_BUILD_CLIENT_SECRET=
SAP_BUILD_TOKEN_URL=

# ── SAP Analytics Cloud (SAC) ──
SAC_STORY_EMBED_URL=

# ── Gemini AI Configuration ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SUITABILITY_THRESHOLD=0.7
